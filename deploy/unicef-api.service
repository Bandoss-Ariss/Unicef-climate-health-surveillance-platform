# /etc/systemd/system/unicef-api.service
[Unit]
Description=UNICEF Climat-Sante API (FastAPI / uvicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/unicef-climat-sante/server
Environment="PATH=/var/www/unicef-climat-sante/server/.venv/bin"
ExecStart=/var/www/unicef-climat-sante/server/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 63000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
